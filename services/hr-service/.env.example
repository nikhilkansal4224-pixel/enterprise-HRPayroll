# -----------------------------------------------------------------------------
# HR & Payroll backend — environment variables
# Copy this file to `.env` and fill in real values from your Supabase project
# (Project Settings -> API, and Project Settings -> Database).
# -----------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase project
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Service role key: NEVER expose to the frontend. Backend-only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Postgres connection for Prisma.
# Use the Supabase "connection pooling" (pgbouncer) URL for the app,
# and the direct connection URL for running migrations.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"

# Statutory config (used by payroll calculator, override per country/policy)
PF_EMPLOYEE_RATE=0.12
PF_WAGE_CEILING=15000
